      "cols_encoding": {
        "education": {
          "1": "Grad.School",
          "2": "University",
          "3": "High School",
          "4": "Others",
          "0": "Others",
          "5": "Others",
          "6": "Others"
        },
        "sex": {
          "1": "Male",
          "2": "Female"
        },
        "marital": {
          "1": "Married",
          "2": "Single",
          "3": "Other",
          "0": "Other"
        }
      },
      "custom_mv": null,
      "pipeline": {
        "bool_pip" : {
          "imputer": {
            "params": {
              "strategy": "mean"
            }
          }
        },
        "num_pip" : {
          "imputer": {"params": {"strategy": "mean"}},
          "scaler": {"type":  "min_max", "params": {}}
        },
        "cat_pip": {
          "imputer": {"params": {"strategy": "most_frequent"}},
          "onehot": {"params":{"handle_unknown":"ignore", "sparse_output": false, "dtype":"np.int64"}}
        }
      },
      "target_encoding": {"0": 0, "1": 1}
    },
    "fairness": {
      "sensitives": {
        "sex" : {
          "Male": 0, "Female":1
        },
        "marital": {
          "Single": 1, "Married": 0, "Other": 1
        }
      },
      "fav_labels_mapping": {
        "1": 0,
        "0": 1
      }

    }
  },
